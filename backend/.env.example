# Copie para .env e preencha. No Modal: modal secret create tropicalize --from-dotenv .env

# Banco (Supabase > Project Settings > Database > Connection string, modo "Transaction pooler")
DATABASE_URL=postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Supabase Auth (Project Settings > API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=

# Claude (console.anthropic.com)
ANTHROPIC_API_KEY=
# MODELO_PROFUNDO=claude-fable-5-1     # relatórios (o mais capaz)
# MODELO_PESQUISA=claude-sonnet-5-5    # enriquecimento em lote com busca na web
# MODELO_RAPIDO=claude-haiku-5-5       # notícias, extração de dados
# ESFORCO_RELATORIO=high               # low | medium | high | xhigh | max

# Gemini embeddings (aistudio.google.com)
GEMINI_API_KEY=

# NUVC (nuvc.ai/api-platform/keys). Sem chave, os relatórios saem sem as ferramentas do NUVC.
NUVC_API_KEY=
# NUVC_COMANDO=npx -y nuvc-mcp        # localmente; no Modal o padrão "nuvc-mcp" já está instalado

# Apify (console.apify.com > Settings > Integrations)
APIFY_TOKEN=

# Quem pode aprovar notícias no /admin (e-mails separados por vírgula)
ADMIN_EMAILS=enzofavato06@gmail.com

# Endereço do site e origens que podem chamar a API
SITE_URL=https://tropicalize.app
ORIGENS_PERMITIDAS=http://localhost:3000,https://tropicalize.app,capacitor://localhost,https://localhost

# Análises por mês
COTA_GRATIS=5
COTA_PRO=100
TAXA_USD_BRL=5.5

# Push na PWA (gere com: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTATO=mailto:contato@tropicalize.app
# Push nos apps nativos: JSON da conta de serviço do Firebase em uma linha
FIREBASE_CREDENCIAIS_JSON=

# Webhook que publica nas redes (Make, Zapier, n8n...). Recebe {rede, texto, titulo, link, imagem}
WEBHOOK_REDES_SOCIAIS=
